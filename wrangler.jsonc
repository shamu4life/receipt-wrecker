{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receipt-wrecker",
  "compatibility_date": "2026-06-19",
  "observability": { "enabled": true },
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",

  // The app's domain is listed, and that is not optional.
  //
  // Once routes appear in this file, it is the source of truth for them: a deploy
  // reconciles the Worker's route set to this list, so anything you want reachable
  // has to be in it. (receipt.uwutoowo.com was once configured only in the dashboard.)
  //
  // custom_domain:true means Cloudflare manages the hostname end to end (DNS record
  // + certificate) rather than matching a pattern on an existing route.
  //
  // 1.8.1, by the owner's decision, took out i.uwutoowo.com, the short host of the
  // links the old /upload route made, together with /upload and the RW_IMG_HOST var
  // that pointed its links there: the app stopped using them in 1.8.0. Deploying this
  // list detaches that domain from the Worker.
  "routes": [
    { "pattern": "receipt.uwutoowo.com", "custom_domain": true }
  ],

  "assets": { "directory": "./public", "binding": "ASSETS" },
  // /imgbb keeps each viewer's hourly count of uploads here (keys upload-rate/...), and
  // answers "uploads are off right now" without it. Its ImgBB API key is the Worker
  // secret IMGBB_KEY, never in this file.
  "kv_namespaces": [
    { "binding": "RW_IMG", "id": "d3753f3a45b44992b0aa815ae5a5c6e1" }
  ]
}
